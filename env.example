# CineFlow AI Studio Environment Variables Template
# Copy this file to .env.local for local overrides.
# DO NOT COMMIT REAL CREDENTIALS, SECRETS, OR TOKENS TO SOURCE CONTROL.

# Application Configuration
NEXT_PUBLIC_APP_NAME="CineFlow AI Studio"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secure-random-32-character-secret-key-here"

# Server-Side FFmpeg Engine
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# Google Flow & Google OAuth Integration (Official OAuth 2.0 Client)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Google Vertex AI / Veo (Official Enterprise Video API)
GOOGLE_VERTEX_PROJECT_ID="your-gcp-project-id"
GOOGLE_VERTEX_LOCATION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/service-account-key.json"

# Runway Gen-3 Alpha Video Provider
RUNWAY_API_KEY="your-runway-api-key-here"

# Higgsfield Cinema Video Provider
HIGGSFIELD_API_KEY="your-higgsfield-api-key-here"

# Kling AI Video Provider
KLING_API_KEY="your-kling-api-key-here"

# YouTube Data API v3 (For Direct Publishing Workflow)
YOUTUBE_API_KEY="your-youtube-data-api-v3-key-here"
YOUTUBE_CLIENT_ID="your-youtube-oauth-client-id"
YOUTUBE_CLIENT_SECRET="your-youtube-oauth-client-secret"

# LLM Providers (Optional for Script & Synopsis Generation - local fallback provided)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
